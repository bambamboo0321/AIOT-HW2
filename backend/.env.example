# Load these values in your shell or hosting dashboard; never commit a real token.
AEP_SERVICE_TOKEN=replace_with_a_random_base64url_token_at_least_32_characters
# Local absolute Python path. The container sets its own /usr/local/bin/python.
AEP_PYTHON=/absolute/path/to/AIOT-HW2/.venv/bin/python
AEP_BIND_HOST=127.0.0.1
PORT=8000
